{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.nac7/tooltrim",
  "title": "tooltrim",
  "description": "Compress LLM agent tool outputs before they re-enter context; full output retrievable via a ref.",
  "version": "0.3.2",
  "repository": {
    "url": "https://github.com/nac7/tooltrim",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "tooltrim",
      "version": "0.3.2",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "tooltrim[mcp]"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        }
      ]
    }
  ]
}
